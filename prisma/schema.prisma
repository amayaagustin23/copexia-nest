// schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum CommentStatus {
  APPROVED
  PENDING
  REJECTED
  DELETED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("users")
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  color       String?        @default("#6366f1")
  icon        String?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       PostCategory[]

  @@map("categories")
}

model Post {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  content       String // Contenido del post en formato HTML
  excerpt       String? // Resumen del post en texto plano
  featuredImage String?
  status        PostStatus @default(DRAFT)
  isPinned      Boolean    @default(false)
  viewCount     Int        @default(0)
  likeCount     Int        @default(0) // Solo contador, sin tracking individual
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relaciones
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categories PostCategory[]
  comments   Comment[]

  @@map("posts")
}

model PostCategory {
  id         String   @id @default(uuid())
  postId     String
  categoryId String
  createdAt  DateTime @default(now())

  // Relaciones
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@map("post_categories")
}

model Comment {
  id            String        @id @default(uuid())
  content       String // Contenido del comentario en formato HTML
  authorName    String // Nombre del comentarista
  authorEmail   String? // Email del comentarista (opcional)
  authorWebsite String? // Website del comentarista (opcional)
  status        CommentStatus @default(PENDING)
  parentId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  postId  String
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// Analytics Models - RESTRUCTURED

model AnalyticsVisitor {
  id               String @id @default(uuid()) // Correspond to Frontend "sessionId" (Browser ID)
  userAgent        String
  deviceType       String
  browser          String
  os               String
  screenResolution String
  viewportSize     String
  language         String

  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt // Updated on every interaction

  sessions AnalyticsSession[]

  @@map("analytics_visitors")
}

model AnalyticsSession {
  id        String           @id @default(uuid())
  visitorId String
  visitor   AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int? // Total session duration

  // Aggregated stats per page/section in JSON
  // Structure: { "/home": { views: 1, duration: 10 }, "/about": { ... } }
  pageViews Json?

  engagement String?

  events AnalyticsEvent[]

  @@index([visitorId])
  @@index([startTime])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id        String           @id @default(uuid())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  eventType String
  eventData Json?
  page      String? // Context of the event
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@map("analytics_events")
}

// Modelo para agregaciones diarias
model AnalyticsDailySummary {
  id   String   @id @default(uuid())
  date DateTime @unique

  totalVisits    Int @default(0) // Page Loads
  uniqueVisitors Int @default(0)
  totalSessions  Int @default(0)

  avgSessionDuration Float?
  avgScrollDepth     Float?
  bounceRate         Float?

  deviceBreakdown  Json?
  browserBreakdown Json?
  osBreakdown      Json?

  topPages Json? // [{page: "/home", views: 100}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("analytics_daily_summary")
}
