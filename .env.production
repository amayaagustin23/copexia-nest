# Database Configuration
DATABASE_URL=postgresql://copexia:your_password@postgres:5432/copexia
POSTGRES_DB=copexia
POSTGRES_USER=copexia
POSTGRES_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here

# Email Configuration (Mailjet)
EMAIL_SENDER=your-email@domain.com
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Frontend URLs
BACKOFFICE_RESET_PASSWORD_URL=https://portfolio-ecomerce.shop/reset-password
BACKOFFICE_BASE_URL=https://portfolio-ecomerce.shop
FRONTEND_URL=https://portfolio-ecomerce.shop
API_URL=https://portfolio-ecomerce.shop/api/v1

# pgAdmin Configuration
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_pgadmin_password

# Application Configuration
NODE_ENV=production
PORT=3000
