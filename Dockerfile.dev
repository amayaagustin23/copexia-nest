# Dockerfile para desarrollo
FROM node:20-slim

# Instalar dependencias necesarias para canvas y compilación
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    libcairo2-dev \
    libjpeg-dev \
    libpango1.0-dev \
    libgif-dev \
    librsvg2-dev \
    libpixman-1-dev \
    libpangocairo-1.0-0 \
    libjpeg-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

# Establecer directorio de trabajo
WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./
COPY yarn.lock ./

# Instalar dependencias
RUN yarn install

# Copiar código fuente
COPY . .

# Generar Prisma client
RUN npx prisma generate

# Exponer puerto
EXPOSE 3000

# Comando por defecto para desarrollo
CMD ["yarn", "start:dev"]
